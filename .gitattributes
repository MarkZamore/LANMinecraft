# Preserve the exact native-tested logging payload used by published packs.
tools/PackData/Logging/log4j2.xml -text

# Keep the embedded checked Steam index byte-identical to the publisher profile.
Program/Resources/steam-components.json -text whitespace=cr-at-eol
Program/Resources/steam-components-v2.json -text whitespace=cr-at-eol

# Keep the read-only Bedrock probe and its recorded source hashes reproducible.
tools/Bedrock/** text eol=lf
tools/numbered-pack-ids.json text eol=lf
tools/test_numbered_pack_catalog.py text eol=lf
