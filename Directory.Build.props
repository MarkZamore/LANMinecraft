<Project>

  <!-- Every project here - the launcher, its tests and the delta tool - is
       audited by restore itself: a package with a known moderate or worse
       vulnerability, direct or transitive, fails the restore. This is the
       release's dependency audit; there is no separate listing step. -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

</Project>
