<Window x:Class="Minecraft.WorldRemovalConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Удаление мира"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{DynamicResource WindowStyle}">
    <StackPanel x:Name="RemovalPanel"
                Width="{StaticResource Size.DialogWidth}"
                Margin="{StaticResource Gap.Canvas}">
        <TextBlock x:Name="QuestionText"
                   FontSize="{StaticResource Font.SizeHeading}"
                   Style="{StaticResource EmphasisTextStyle}"
                   TextWrapping="Wrap"/>
        <TextBlock x:Name="ExplanationText"
                   Margin="{StaticResource Gap.Above2}"
                   Style="{StaticResource ParagraphTextStyle}"
                   TextWrapping="Wrap"/>
        <!-- Two answers, and the one that does nothing is what Enter and Esc
             both give. Deleting has to be pressed on purpose. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource Gap.Above4}">
            <Button x:Name="DeleteButton" Content="Да"
                    Padding="{StaticResource Pad.Wide}" Click="DeleteButton_Click"/>
            <Button x:Name="KeepButton" Content="Нет" IsCancel="True" IsDefault="True"
                    Margin="{StaticResource Gap.Left2}" Padding="{StaticResource Pad.Wide}"
                    Click="KeepButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
