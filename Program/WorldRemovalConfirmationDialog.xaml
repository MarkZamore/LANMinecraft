<Window x:Class="Minecraft.WorldRemovalConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Удаление мира"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{DynamicResource WindowStyle}">
    <Window.Resources>
        <DataTemplate x:Key="RemovalChoiceContentTemplate">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
        </DataTemplate>
    </Window.Resources>
    <StackPanel x:Name="RemovalPanel"
                Width="{StaticResource Size.DialogWidth}"
                Margin="{StaticResource Gap.Canvas}">
        <TextBlock x:Name="QuestionText"
                   FontSize="{StaticResource Font.SizeHeading}"
                   Style="{StaticResource EmphasisTextStyle}"
                   Focusable="True"
                   TextWrapping="Wrap"/>
        <Grid Margin="{StaticResource Gap.Above4}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{StaticResource Size.DialogActionGap}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="DeleteButton" Grid.Column="0" Content="Удалить мир"
                    ContentTemplate="{StaticResource RemovalChoiceContentTemplate}"
                    Padding="{StaticResource Pad.Wide}" Click="DeleteButton_Click"/>
            <Button x:Name="AllWorldsButton" Grid.Column="2" Content="Удалить все миры"
                    ContentTemplate="{StaticResource RemovalChoiceContentTemplate}"
                    Padding="{StaticResource Pad.Wide}" Click="AllWorldsButton_Click"/>
        </Grid>
    </StackPanel>
</Window>
