<Window x:Class="Minecraft.NoticeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LANMinecraft"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        Style="{DynamicResource WindowStyle}">
    <StackPanel x:Name="NoticePanel"
                Width="{StaticResource Size.DialogWidth}"
                Margin="{StaticResource Gap.Canvas}">
        <TextBlock x:Name="HeadingText"
                   FontSize="{StaticResource Font.SizeHeading}"
                   Style="{StaticResource EmphasisTextStyle}"
                   TextWrapping="Wrap"/>
        <TextBlock x:Name="DetailText"
                   Margin="{StaticResource Gap.Above2}"
                   Style="{StaticResource ParagraphTextStyle}"
                   TextWrapping="Wrap"/>
    </StackPanel>
</Window>
