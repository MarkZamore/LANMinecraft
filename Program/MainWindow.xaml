<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="clr-namespace:Minecraft"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Minecraft.MainWindow"
    Title="LANMinecraft"
    Width="{DynamicResource Size.WindowWidth}"
    Height="{DynamicResource Size.WindowHeight}"
    MinWidth="{DynamicResource Size.WindowMinWidth}"
    MinHeight="{DynamicResource Size.WindowMinHeight}"
    WindowStartupLocation="CenterScreen"
    Style="{DynamicResource WindowStyle}"
    Icon="Minecraft.ico"
    Loaded="Window_Loaded"
    Closing="Window_Closing"
    ResizeMode="CanResize"
    WindowStyle="SingleBorderWindow"
    UseLayoutRounding="True">
    <Window.Resources>
        <DataTemplate x:Key="BuildItemTemplate">
            <TextBlock Text="{Binding Name}"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding Name}"
                Margin="{StaticResource Gap.Right3}" />
        </DataTemplate>
        <DataTemplate x:Key="WorldItemTemplate">
            <TextBlock Text="{Binding DisplayName}"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding DisplayName}"
                Margin="{StaticResource Gap.Right3}" />
        </DataTemplate>
        <DataTemplate x:Key="PeerItemTemplate">
            <TextBlock Text="{Binding DisplayName}"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding DisplayName}"
                Margin="{StaticResource Gap.Right3}" />
        </DataTemplate>
        <DataTemplate x:Key="DiagnosticTargetItemTemplate">
            <TextBlock Text="{Binding DisplayName}"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding DisplayName}"
                Margin="{StaticResource Gap.Right3}" />
        </DataTemplate>
        <DataTemplate x:Key="ChangelogEntryTemplate">
            <StackPanel Margin="{StaticResource Gap.Below3}">
                <TextBlock Text="{Binding Title}" Style="{StaticResource EmphasisTextStyle}" VerticalAlignment="Top" />
                <TextBlock Text="{Binding Text}"
                    Style="{StaticResource ParagraphTextStyle}"
                    Margin="{StaticResource Gap.Above1}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="{StaticResource Gap.Canvas}" x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="{StaticResource Size.ColumnGap}" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="1" Margin="{StaticResource Gap.Below4}" x:Name="PlayArea">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource Size.ScrollGutter}" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PlayButton"
                Grid.Column="0"
                Click="PlayButton_Click"
                Style="{StaticResource PrimaryButtonStyle}"
                ToolTipService.ShowOnDisabled="True"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch">
                <Grid>
                    <ProgressBar x:Name="PlayProgressBar"
                        Minimum="0"
                        Maximum="100"
                        Style="{StaticResource PlayProgressBarStyle}"
                        Visibility="Collapsed" />
                    <TextBlock x:Name="PlayButtonText"
                        Text="Играть"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                        TextAlignment="Center" />
                </Grid>
            </Button>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
            ClipToBounds="True"
            Margin="{StaticResource Gap.Below4}"
            HorizontalScrollBarVisibility="Disabled"
            VerticalContentAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            x:Name="BodyScroll"
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="1"
            Style="{StaticResource LauncherBodyScrollViewerStyle}">
            <Grid x:Name="BodyGrid">
                <Grid x:Name="MainPanel" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="1"
                        Margin="{StaticResource Gap.Below4}"
                        x:Name="SettingsGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0" Margin="{StaticResource Gap.Right2}" x:Name="NameSettingsRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource Size.LabelColumn}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Имя" Style="{StaticResource LabelTextStyle}" />
                            <Grid Grid.Column="1" Margin="{StaticResource Gap.Right2}">
                                <TextBox x:Name="PlayerNameTextBox"
                                    MaxLength="16"
                                    IsReadOnly="True"
                                    TextChanged="PlayerNameTextBox_TextChanged"
                                    PreviewTextInput="PlayerNameTextBox_PreviewTextInput"
                                    DataObject.Pasting="PlayerNameTextBox_Pasting"
                                    LostFocus="PlayerNameTextBox_LostFocus"
                                    KeyDown="PlayerNameTextBox_KeyDown"
                                    MinWidth="{StaticResource Size.ButtonMin}" />
                                <TextBlock Text="Ник не задан" VerticalAlignment="Center" Margin="{StaticResource Pad.FieldText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=PlayerNameTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Grid.Column="2"
                                x:Name="ChangePlayerNameButton"
                                Content="Изменить"
                                Click="ChangePlayerNameButton_Click"
                                Width="{StaticResource Size.ButtonMax}" />
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="0" Margin="{StaticResource Gap.Above2Right2}" x:Name="BuildSettingsRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource Size.LabelColumn}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Сборка" Style="{StaticResource LabelTextStyle}" />
                            <Grid Grid.Column="1">
                                <local:CenteredDropDown x:Name="BuildComboBox"
                                    ItemTemplate="{StaticResource BuildItemTemplate}"
                                    SelectionChanged="BuildComboBox_SelectionChanged" />
                                <TextBlock x:Name="BuildPlaceholderText"
                                    Text="Нет сборок"
                                    Style="{StaticResource PlaceholderTextStyle}"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="{StaticResource Gap.Left2}" x:Name="MemorySettingsRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="{StaticResource Size.NumberField}" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                x:Name="SkinButton"
                                Content="Скин"
                                Click="SkinButton_Click"
                                HorizontalAlignment="Stretch" />
                            <TextBlock Grid.Column="1"
                                Text="RAM"
                                Style="{StaticResource LabelTextStyle}"
                                Margin="{StaticResource Gap.Left3Right2}" />
                            <TextBox Grid.Column="2"
                                x:Name="MemoryTextBox"
                                FontSize="{StaticResource Font.SizeInput}"
                                TextAlignment="Center"
                                PreviewTextInput="MemoryTextBox_PreviewTextInput"
                                TextChanged="MemoryTextBox_TextChanged"
                                DataObject.Pasting="MemoryTextBox_Pasting"
                                LostFocus="MemoryTextBox_LostFocus"
                                KeyDown="MemoryTextBox_KeyDown" />
                            <TextBlock Grid.Column="3"
                                Text="ГБ"
                                Style="{StaticResource LabelTextStyle}"
                                Margin="{StaticResource Gap.Left2}" />
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="{StaticResource Gap.Left2Above2}" x:Name="PresetSettingsRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="{StaticResource Size.EstimateColumn}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                x:Name="DeleteBuildButton"
                                Style="{StaticResource IconActionButton}"
                                Padding="{StaticResource Pad.None}"
                                Click="DeleteBuildButton_Click"
                                IsEnabled="False"
                                ToolTipService.ShowOnDisabled="True">
                                <TextBlock Text="&#xE74D;"
                                    FontFamily="{StaticResource Font.Icons}"
                                    FontSize="{StaticResource Size.Icon}"
                                    TextWrapping="NoWrap" />
                            </Button>
                            <TextBlock Grid.Column="1"
                                x:Name="MemoryEstimateText"
                                Style="{StaticResource LabelTextStyle}"
                                TextTrimming="CharacterEllipsis"
                                Margin="{StaticResource Gap.Left2}" />
                            <Button Grid.Column="2"
                                x:Name="ControlsPresetButton"
                                Content="Пресет управления"
                                Margin="{StaticResource Gap.Left2}"
                                Click="ControlsPresetButton_Click"
                                IsEnabled="False"
                                ToolTipService.ShowOnDisabled="True"
                                HorizontalAlignment="Stretch" />
                        </Grid>
                    </Grid>
                    <Grid x:Name="DiagnosticStatusArea" Grid.Row="1" Margin="{StaticResource Gap.Below4}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                            Text="Статус"
                            Style="{StaticResource LabelTextStyle}"
                            Margin="{StaticResource Gap.Below2}" />
                        <TextBox Grid.Row="1"
                            x:Name="DiagnosticLogStatusText"
                            Height="{StaticResource Size.StatusArea}"
                            Padding="{StaticResource Pad.Text}"
                            IsReadOnly="True"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto"
                            VerticalContentAlignment="Top"
                            ToolTip="Состояние лаунчера и подключения." />
                    </Grid>
                    <Expander x:Name="WorldTransferExpander"
                        Grid.Row="2"
                        IsExpanded="False"
                        Margin="{StaticResource Gap.Below2}"
                        AutomationProperties.Name="Передача мира">
                        <Expander.Header>
                            <TextBlock Text="Передача мира"
                                Style="{StaticResource SectionTitleStyle}"
                                Margin="{StaticResource Gap.None}" />
                        </Expander.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="1"
                                Margin="{StaticResource Gap.Below2}"
                                x:Name="WorldTransferPanel">
                                <Grid Margin="{StaticResource Gap.Below2}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource Size.LabelColumn}" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Мир" Style="{StaticResource LabelTextStyle}" />
                                    <Grid Grid.Column="1">
                                        <local:CenteredDropDown x:Name="WorldComboBox"
                                            ItemTemplate="{StaticResource WorldItemTemplate}"
                                            SelectionChanged="WorldComboBox_SelectionChanged" />
                                        <TextBlock x:Name="WorldPlaceholderText"
                                            Text="Нет миров для передачи"
                                            Style="{StaticResource PlaceholderTextStyle}"
                                            Visibility="Collapsed" />
                                    </Grid>
                                    <Button Grid.Column="2"
                                        x:Name="DeleteWorldButton"
                                        Style="{StaticResource IconActionButton}"
                                        Margin="{StaticResource Gap.Left2}"
                                        Padding="{StaticResource Pad.None}"
                                        Click="DeleteWorldButton_Click"
                                        IsEnabled="False"
                                        ToolTipService.ShowOnDisabled="True">
                                        <TextBlock Text="&#xE74D;"
                                            FontFamily="{StaticResource Font.Icons}"
                                            FontSize="{StaticResource Size.Icon}"
                                            TextWrapping="NoWrap" />
                                    </Button>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource Size.LabelColumn}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Игрок" Style="{StaticResource LabelTextStyle}" />
                                    <Grid Grid.Column="1">
                                        <local:CenteredDropDown x:Name="OnlinePlayerComboBox"
                                            ItemTemplate="{StaticResource PeerItemTemplate}"
                                            SelectionChanged="TransferSelectionChanged" />
                                        <TextBlock x:Name="OnlinePlayerPlaceholderText"
                                            Text="Нет игроков в сети"
                                            Style="{StaticResource PlaceholderTextStyle}"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                            <Grid Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="1"
                                Margin="{StaticResource Gap.None}"
                                x:Name="TransferArea">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" x:Name="TransferProgressArea" IsEnabled="False">
                                    <ProgressBar x:Name="TransferProgressBar"
                                        Minimum="0"
                                        Maximum="100"
                                        Foreground="{StaticResource Brush.ProgressTrack}" />
                                    <TextBlock x:Name="TransferProgressText"
                                        Text="В ожидании мира"
                                        Style="{StaticResource ProgressTextStyle}" />
                                </Grid>
                                <Button Grid.Column="1"
                                    x:Name="TransferButton"
                                    Content="Передать"
                                    Click="TransferButton_Click"
                                    Margin="{StaticResource Gap.Left2}"
                                    MinWidth="{StaticResource Size.ButtonMin}"
                                    Width="{StaticResource Size.ButtonMax}" />
                            </Grid>
                        </Grid>
                    </Expander>
                    <Expander x:Name="ReportExpander"
                        Grid.Row="3"
                        IsExpanded="False"
                        AutomationProperties.Name="Сообщить о проблеме">
                        <Expander.Header>
                            <TextBlock Text="Сообщить о проблеме"
                                Style="{StaticResource SectionTitleStyle}"
                                Margin="{StaticResource Gap.None}" />
                        </Expander.Header>
                        <Grid Grid.Column="0" Grid.ColumnSpan="1" Margin="{StaticResource Gap.None}" x:Name="ReportPanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Margin="{StaticResource Gap.Below2}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource Size.LabelColumn}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Кому" Style="{StaticResource LabelTextStyle}" />
                                <Grid Grid.Column="1">
                                    <local:CenteredDropDown x:Name="DiagnosticLogTargetComboBox"
                                        ItemTemplate="{StaticResource DiagnosticTargetItemTemplate}" />
                                    <TextBlock x:Name="DiagnosticLogTargetPlaceholderText"
                                        Text="Нет игроков в сети"
                                        Style="{StaticResource PlaceholderTextStyle}"
                                        Visibility="Collapsed" />
                                </Grid>
                                <Button Grid.Column="2"
                                    x:Name="SendBugReportButton"
                                    Content="Отправить"
                                    Click="SendBugReportButton_Click"
                                    Margin="{StaticResource Gap.Left2}"
                                    MinWidth="{StaticResource Size.ButtonMin}"
                                    Width="{StaticResource Size.ButtonMax}" />
                            </Grid>
                            <Grid Margin="{StaticResource Gap.None}" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource Size.LabelColumn}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                    Text="Описание"
                                    Style="{StaticResource LabelTextStyle}"
                                    VerticalAlignment="Top"
                                    Margin="{StaticResource Gap.Above2}" />
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="BugReportMessageTextBox"
                                        Padding="{StaticResource Pad.Text}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto"
                                        VerticalContentAlignment="Top"
                                        MaxLength="4000"
                                        MinHeight="{StaticResource Size.TextArea}"
                                        Height="{StaticResource Size.TextArea}" />
                                    <TextBlock x:Name="BugReportPlaceholderText"
                                        Text="Что случилось (необязательно)"
                                        VerticalAlignment="Top"
                                        IsHitTestVisible="False"
                                        Margin="{StaticResource Pad.FieldText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderTextStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Text, ElementName=BugReportMessageTextBox}" Value="" />
                                                            <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=BugReportMessageTextBox}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Expander>
                </Grid>
            </Grid>
        </ScrollViewer>
        <ScrollBar x:Name="BodyScrollBar"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            HorizontalAlignment="Right"
            Width="{StaticResource Size.Scrollbar}"
            Margin="{StaticResource Gap.Below4}"
            Orientation="Vertical"
            Focusable="True"
            Maximum="{Binding ScrollableHeight, ElementName=BodyScroll}"
            ViewportSize="{Binding ViewportHeight, ElementName=BodyScroll}"
            SmallChange="{StaticResource Font.LineHeightBody}"
            LargeChange="{Binding ViewportHeight, ElementName=BodyScroll}"
            Visibility="{Binding ComputedVerticalScrollBarVisibility, ElementName=BodyScroll}"
            local:ScrollBarBridge.Target="{Binding ElementName=BodyScroll}"
            AutomationProperties.Name="Прокрутка настроек и действий" />
        <Border x:Name="SidePanelCard"
            Grid.Column="2"
            Grid.Row="0"
            Grid.RowSpan="3"
            Margin="{StaticResource Gap.Below2}"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="{StaticResource Border.Control}"
            CornerRadius="{StaticResource Radius.Panel}"
            Padding="{StaticResource Pad.Panel}"
            AutomationProperties.Name="Помощник и новости">
            <Grid x:Name="SidePanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="SidePanelTitle"
                    Grid.Row="0"
                    Text="AI-помощник"
                    Style="{StaticResource SectionTitleStyle}"
                    Height="{StaticResource Size.SidePanelHeader}"
                    FontSize="{StaticResource Font.SizeHeading}"
                    LineHeight="{StaticResource Font.LineHeightHeading}"
                    TextWrapping="NoWrap"
                    Margin="{StaticResource Gap.None}" />
                <Grid Grid.Row="1" Margin="{StaticResource Gap.Above4}">
                    <Grid x:Name="ChangelogPanel" Visibility="Collapsed">
                        <ScrollViewer x:Name="ChangelogScroll"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            Padding="{StaticResource Gap.Right3}"
                            Style="{StaticResource FluentScrollViewer}">
                            <ItemsControl x:Name="ChangelogList"
                                ItemTemplate="{StaticResource ChangelogEntryTemplate}"
                                Focusable="False" />
                        </ScrollViewer>
                        <TextBlock x:Name="ChangelogUnavailableText"
                            Text="История изменений недоступна"
                            Style="{StaticResource CaptionTextStyle}"
                            VerticalAlignment="Top"
                            Visibility="Collapsed" />
                    </Grid>
                    <Grid x:Name="ChatPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                            x:Name="ChatAvailabilityText"
                            Text="Подключение помощника пока недоступно"
                            Style="{StaticResource ParagraphTextStyle}"
                            TextAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="{StaticResource Gap.Right3}" />
                        <local:ChatComposer x:Name="ChatComposerControl" Grid.Row="1" IsServiceAvailable="False">
                            <Border x:Name="ChatComposerFrame" Style="{StaticResource ChatComposerFrameStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <TextBox x:Name="ChatMessageTextBox"
                                            Style="{StaticResource ChatPromptTextBoxStyle}"
                                            Text="{Binding Prompt, ElementName=ChatComposerControl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            AcceptsReturn="True"
                                            TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto"
                                            HorizontalScrollBarVisibility="Disabled"
                                            MaxLength="131000"
                                            AutomationProperties.Name="Сообщение помощнику"
                                            AutomationProperties.HelpText="Shift+Enter: новая строка" />
                                        <TextBlock x:Name="ChatPromptPlaceholderText"
                                            Text="Напишите сообщение"
                                            VerticalAlignment="Top"
                                            IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderTextStyle}">
                                                    <Setter Property="Margin" Value="{StaticResource Gap.None}" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Text, ElementName=ChatMessageTextBox}" Value="" />
                                                                <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=ChatMessageTextBox}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="{StaticResource Gap.Above2}">
                                        <Button x:Name="ChatSendButton"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource ChatActionButtonStyle}"
                                            Content="{Binding ActionLabel, ElementName=ChatComposerControl}"
                                            Tag="{Binding IsGenerating, ElementName=ChatComposerControl}"
                                            Command="{x:Static local:ChatComposer.ActionCommand}"
                                            CommandTarget="{Binding ElementName=ChatComposerControl}"
                                            IsEnabled="{Binding IsActionEnabled, ElementName=ChatComposerControl}"
                                            ToolTip="{Binding ActionToolTip, ElementName=ChatComposerControl}"
                                            ToolTipService.ShowOnDisabled="True"
                                            AutomationProperties.Name="{Binding ActionLabel, ElementName=ChatComposerControl}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </local:ChatComposer>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="1" Margin="{StaticResource Gap.Below2}" x:Name="UpdateArea">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <ProgressBar x:Name="UpdateProgressBar"
                    Minimum="0"
                    Maximum="100"
                    Foreground="{StaticResource Brush.ProgressTrack}" />
                <TextBlock x:Name="UpdateProgressText"
                    Text="Проверка обновлений"
                    Style="{StaticResource ProgressTextStyle}" />
            </Grid>
            <Button Grid.Column="1"
                x:Name="UpdateButton"
                Content="Обновить"
                Click="UpdateButton_Click"
                Margin="{StaticResource Gap.Left2}"
                MinWidth="{StaticResource Size.ButtonMin}"
                IsEnabled="False"
                Width="{StaticResource Size.ButtonMax}" />
        </Grid>
        <Grid x:Name="FooterGrid" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="{StaticResource Size.ColumnGap}" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="1"
                Orientation="Horizontal"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                x:Name="FooterMotto">
                <TextBlock Text="Лучше TLauncher" />
            </StackPanel>
            <Grid Grid.Row="0" Grid.Column="2" Margin="{StaticResource Gap.None}" x:Name="FooterActions" Grid.ColumnSpan="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Steam:" Margin="{StaticResource Gap.Right1}" Grid.Column="0" />
                    <TextBlock x:Name="SteamPersonaText"
                        Visibility="Collapsed"
                        Grid.Column="1"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
                <Button Grid.Column="1"
                    x:Name="RetrySteamButton"
                    Content="Повторить"
                    Margin="{StaticResource Gap.Right2}"
                    MinWidth="{StaticResource Size.ButtonMin}"
                    Click="RetrySteamButton_Click"
                    Width="{StaticResource Size.ButtonMax}" />
                <Button Grid.Column="2"
                    x:Name="SidePanelToggleButton"
                    Content="Новости"
                    Click="SidePanelToggleButton_Click"
                    HorizontalAlignment="Right"
                    MinWidth="{StaticResource Size.ButtonMin}"
                    Width="{StaticResource Size.ButtonMax}" />
            </Grid>
        </Grid>
        <Grid Visibility="Collapsed">
            <TextBlock x:Name="PackHashText" />
