<Window x:Class="Minecraft.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Minecraft"
        Title="LANMinecraft" Width="720" Height="515" MinWidth="600" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource WindowStyle}"
        Icon="Minecraft.ico" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <!-- What one row of each list shows. Values read left, like the labels. -->
        <DataTemplate x:Key="BuildItemTemplate">
            <TextBlock Text="{Binding Name}"/>
        </DataTemplate>
        <DataTemplate x:Key="WorldItemTemplate">
            <TextBlock Text="{Binding DisplayName}"/>
        </DataTemplate>
        <DataTemplate x:Key="PeerItemTemplate">
            <TextBlock Text="{Binding DisplayName}"/>
        </DataTemplate>
        <DataTemplate x:Key="DiagnosticTargetItemTemplate">
            <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}"/>
        </DataTemplate>
        <!-- One version in "Что нового": a heading and one paragraph. -->
        <DataTemplate x:Key="ChangelogEntryTemplate">
            <StackPanel Margin="{StaticResource Gap.Below3}">
                <TextBlock Text="{Binding Title}" Style="{StaticResource EmphasisTextStyle}" VerticalAlignment="Top"/>
                <TextBlock Text="{Binding Text}" Style="{StaticResource ParagraphTextStyle}" Margin="{StaticResource Gap.Above1}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Viewbox Stretch="Uniform" StretchDirection="Both">
        <Grid x:Name="RootGrid" Width="820" Height="544" Margin="{StaticResource Gap.Canvas}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="{StaticResource Size.HistoryColumn}"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <!-- A few pixels of slack: the canvas is fixed at what the left
                     column needs, so this row is all but invisible. It is here
                     because the version history beside it spans these rows, and
                     without a star row to hand its overflow to the rows above
                     would stretch to fit the whole history. -->
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- The button is also the progress bar: while the pack and the game are
                 being prepared, the fill draws inside it under the stage text; once
                 the game is up, it is the disabled button that says so. -->
            <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="{StaticResource Gap.Below4}">
                <Button x:Name="PlayButton" Click="PlayButton_Click"
                        Style="{StaticResource PrimaryButtonStyle}">
                    <Grid>
                        <ProgressBar x:Name="PlayProgressBar" Minimum="0" Maximum="100"
                                     Style="{StaticResource PlayProgressBarStyle}"
                                     Visibility="Collapsed"/>
                        <TextBlock x:Name="PlayButtonText" Text="Играть"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </Grid>

            <!-- Two halves of equal width: on the left who you are and what you
                 play, on the right how it looks, how much memory it may use and
                 the pack's key layout. -->
            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="{StaticResource Gap.Below4}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Grid.Column="0" Margin="{StaticResource Gap.Right2}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Size.LabelColumn}"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Имя" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox Grid.Column="1" x:Name="PlayerNameTextBox"
                             MaxLength="16"
                             IsReadOnly="True"
                             TextChanged="PlayerNameTextBox_TextChanged"
                             PreviewTextInput="PlayerNameTextBox_PreviewTextInput"
                             DataObject.Pasting="PlayerNameTextBox_Pasting"
                             LostFocus="PlayerNameTextBox_LostFocus"
                             KeyDown="PlayerNameTextBox_KeyDown"
                             Margin="{StaticResource Gap.Right2}"/>
                    <Button Grid.Column="2" x:Name="ChangePlayerNameButton"
                            Content="Изменить" Click="ChangePlayerNameButton_Click"/>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="0" Margin="{StaticResource Gap.Above2Right2}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Size.LabelColumn}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Сборка" Style="{StaticResource LabelTextStyle}"/>
                    <Grid Grid.Column="1">
                        <local:CenteredDropDown x:Name="BuildComboBox"
                                                ItemTemplate="{StaticResource BuildItemTemplate}"
                                                SelectionChanged="BuildComboBox_SelectionChanged"/>
                        <TextBlock x:Name="BuildPlaceholderText"
                                   Text="Нет сборок"
                                   Style="{StaticResource PlaceholderTextStyle}"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Grid>

                <Grid Grid.Row="0" Grid.Column="1" Margin="{StaticResource Gap.Left2}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="{StaticResource Size.NumberField}"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="SkinButton" Content="Скин" Click="SkinButton_Click"/>
                    <TextBlock Grid.Column="1" Text="RAM" Style="{StaticResource LabelTextStyle}" Margin="{StaticResource Gap.Left3Right2}"/>
                    <TextBox Grid.Column="2" x:Name="MemoryTextBox" FontSize="{StaticResource Font.SizeInput}" TextAlignment="Center"
                             PreviewTextInput="MemoryTextBox_PreviewTextInput"
                             TextChanged="MemoryTextBox_TextChanged"
                             DataObject.Pasting="MemoryTextBox_Pasting"
                             LostFocus="MemoryTextBox_LostFocus" KeyDown="MemoryTextBox_KeyDown"/>
                    <TextBlock Grid.Column="3" Text="GB" Style="{StaticResource LabelTextStyle}" Margin="{StaticResource Gap.Left2}"/>
                </Grid>

                <!-- One press writes the pack's key layout into the game's options,
                     and the button stays quiet until something - the player in
                     game, or the pack - changes what is there. -->
                <Button Grid.Row="1" Grid.Column="1" x:Name="ControlsPresetButton"
                        Content="Пресет настроек управления"
                        Click="ControlsPresetButton_Click"
                        Margin="{StaticResource Gap.Left2Above2}"
                        ToolTipService.ShowOnDisabled="True"/>
            </Grid>

            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="{StaticResource Gap.Below2}">
                <TextBlock Text="Передача мира" Style="{StaticResource SectionTitleStyle}"/>
                <Grid Margin="{StaticResource Gap.Below2}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Size.LabelColumn}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Мир" Style="{StaticResource LabelTextStyle}"/>
                    <Grid Grid.Column="1">
                        <local:CenteredDropDown x:Name="WorldComboBox"
                                                ItemTemplate="{StaticResource WorldItemTemplate}"
                                                SelectionChanged="WorldComboBox_SelectionChanged"/>
                        <TextBlock x:Name="WorldPlaceholderText"
                                   Text="Нет миров для передачи"
                                   Style="{StaticResource PlaceholderTextStyle}"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Size.LabelColumn}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Игрок" Style="{StaticResource LabelTextStyle}"/>
                    <Grid Grid.Column="1">
                        <local:CenteredDropDown x:Name="OnlinePlayerComboBox"
                                                ItemTemplate="{StaticResource PeerItemTemplate}"
                                                SelectionChanged="TransferSelectionChanged"/>
                        <TextBlock x:Name="OnlinePlayerPlaceholderText"
                                   Text="Нет игроков в сети"
                                   Style="{StaticResource PlaceholderTextStyle}"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </StackPanel>

            <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="{StaticResource Gap.Below4}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <ProgressBar x:Name="TransferProgressBar" Minimum="0" Maximum="100"
                                 Foreground="{StaticResource Brush.ProgressTrack}"/>
                    <TextBlock x:Name="TransferProgressText" Text="В ожидании мира"
                               Style="{StaticResource ProgressTextStyle}"/>
                </Grid>
                <Button Grid.Column="1" x:Name="TransferButton" Content="Передать"
                        Click="TransferButton_Click" Margin="{StaticResource Gap.Left2}"
                        MinWidth="{StaticResource Size.ButtonMin}"/>
            </Grid>

            <!-- The report sits with the things a player does, between sending a
                 world and the bars that show what the launcher is doing. -->
            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="{StaticResource Gap.Below4}">
                <TextBlock Text="Сообщить о проблеме" Style="{StaticResource SectionTitleStyle}"/>
                <Grid Margin="{StaticResource Gap.Below2}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Size.LabelColumn}"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Кому" Style="{StaticResource LabelTextStyle}"/>
                    <Grid Grid.Column="1">
                        <local:CenteredDropDown x:Name="DiagnosticLogTargetComboBox"
                                                ItemTemplate="{StaticResource DiagnosticTargetItemTemplate}"/>
                        <TextBlock x:Name="DiagnosticLogTargetPlaceholderText"
                                   Text="Нет игроков в сети"
                                   Style="{StaticResource PlaceholderTextStyle}"
                                   Visibility="Collapsed"/>
                    </Grid>
                    <Button Grid.Column="2" x:Name="SendBugReportButton" Content="Отправить"
                            Click="SendBugReportButton_Click" Margin="{StaticResource Gap.Left2}"
                            MinWidth="{StaticResource Size.ButtonMin}"/>
                </Grid>
                <Grid Margin="{StaticResource Gap.Below2}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Size.LabelColumn}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Описание" Style="{StaticResource LabelTextStyle}"
                               VerticalAlignment="Top" Margin="{StaticResource Gap.Above2}"/>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="BugReportMessageTextBox"
                                 Height="{StaticResource Size.TextArea}"
                                 Padding="{StaticResource Pad.Text}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 MaxLength="4000"/>
                        <TextBlock Text="Что случилось (необязательно)"
                                   VerticalAlignment="Top">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=BugReportMessageTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
                <TextBlock x:Name="DiagnosticLogStatusText" Style="{StaticResource CaptionTextStyle}"
                           TextWrapping="Wrap" MinHeight="{StaticResource Font.LineHeightCaption}"/>
            </StackPanel>

            <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="{StaticResource Gap.Below2}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="100"
                                 Foreground="{StaticResource Brush.ProgressTrack}"/>
                    <TextBlock x:Name="UpdateProgressText" Text="Вы на последней версии"
                               Style="{StaticResource ProgressTextStyle}"/>
                </Grid>
                <Button Grid.Column="1" x:Name="UpdateButton" Content="Обновить"
                        Click="UpdateButton_Click" Margin="{StaticResource Gap.Left2}"
                        MinWidth="{StaticResource Size.ButtonMin}" IsEnabled="False"/>
            </Grid>

            <!-- The right column is the version history. Its star row is bounded
                 by the canvas's fixed height, which is what makes the list scroll
                 instead of growing off the bottom. -->
            <Grid Grid.Column="2" Grid.Row="0" Grid.RowSpan="7" Margin="{StaticResource Gap.Left5}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Что нового" Style="{StaticResource SectionTitleStyle}"/>
                <Grid Grid.Row="1" Margin="{StaticResource Gap.Below2}">
                    <ScrollViewer x:Name="ChangelogScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="{StaticResource Gap.Right3}">
                        <ItemsControl x:Name="ChangelogList"
                                      ItemTemplate="{StaticResource ChangelogEntryTemplate}"
                                      Focusable="False"/>
                    </ScrollViewer>
                    <TextBlock x:Name="ChangelogUnavailableText"
                               Text="История изменений недоступна"
                               Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Top"
                               Visibility="Collapsed"/>
                </Grid>
            </Grid>

            <!-- Steam lives in the footer: the account it signed in as, or - when
                 it could not - the one button that tries again. The reason sits
                 in the button's tooltip and in the log. -->
            <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                        Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="Лучше TLauncher" Style="{StaticResource CaptionTextStyle}"/>
                <TextBlock Text="Steam:" Style="{StaticResource CaptionTextStyle}" Margin="{StaticResource Gap.Left4Right1}"/>
                <TextBlock x:Name="SteamPersonaText" Style="{StaticResource CaptionTextStyle}" Visibility="Collapsed"/>
                <Button x:Name="RetrySteamButton" Content="Повторить"
                        Style="{StaticResource SmallButtonStyle}" Click="RetrySteamButton_Click"/>
            </StackPanel>
            <TextBlock Grid.Row="7" Grid.Column="2" x:Name="VersionTextBlock"
                       Style="{StaticResource CaptionTextStyle}"
                       HorizontalAlignment="Right" TextAlignment="Right"/>

            <Grid Visibility="Collapsed">
                <TextBlock x:Name="PackHashText"/>
                <TextBlock x:Name="TransferStatusText"/>
                <TextBox x:Name="LogTextBox"/>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
