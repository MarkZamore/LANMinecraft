<Window x:Class="Minecraft.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Minecraft"
        Title="LANMinecraft" Height="460" Width="520" MinHeight="460" MinWidth="520"
        WindowStartupLocation="CenterScreen"
        Icon="Minecraft.ico" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlDisabledBorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlDisabledBorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ProgressIdleBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="ProgressFrameStyle" TargetType="Border">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlDisabledBorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <DataTemplate x:Key="BuildItemTemplate">
            <TextBlock Text="{Binding Name}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
        </DataTemplate>
        <DataTemplate x:Key="WorldItemTemplate">
            <TextBlock Text="{Binding DisplayName}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
        </DataTemplate>
        <DataTemplate x:Key="PeerItemTemplate">
            <TextBlock Text="{Binding DisplayName}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
        </DataTemplate>
        <DataTemplate x:Key="DiagnosticTargetItemTemplate">
            <TextBlock Text="{Binding DisplayName}"
                       ToolTip="{Binding DisplayName}"
                       TextAlignment="Center"
                       HorizontalAlignment="Stretch"/>
        </DataTemplate>
        <DataTemplate x:Key="NetworkAddressItemTemplate">
            <TextBlock Text="{Binding DisplayName}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
        </DataTemplate>
    </Window.Resources>

    <Viewbox Stretch="Uniform" StretchDirection="Both">
        <Grid x:Name="RootGrid" Width="820" Height="700" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="270"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="72"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,16,10">
                <Button x:Name="PlayButton" Content="Играть" Click="PlayButton_Click"
                        MinHeight="38" FontSize="16" FontWeight="SemiBold"/>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Имя"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="PlayerNameTextBox"
                         MaxLength="16"
                         IsReadOnly="True"
                         TextChanged="PlayerNameTextBox_TextChanged"
                         PreviewTextInput="PlayerNameTextBox_PreviewTextInput"
                         DataObject.Pasting="PlayerNameTextBox_Pasting"
                         LostFocus="PlayerNameTextBox_LostFocus"
                         KeyDown="PlayerNameTextBox_KeyDown"
                         Margin="8,0,6,0"/>
                <Button Grid.Row="0" Grid.Column="2" x:Name="ChangePlayerNameButton"
                        Content="Изменить" Click="ChangePlayerNameButton_Click"
                        MinWidth="72" Margin="0,0,12,0"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Сборка"/>
                <Grid Grid.Row="0" Grid.Column="4" Margin="8,0,0,0">
                    <local:CenteredDropDown x:Name="BuildComboBox"
                                            ItemTemplate="{StaticResource BuildItemTemplate}"
                                            SelectionChanged="BuildComboBox_SelectionChanged"/>
                    <TextBlock x:Name="BuildPlaceholderText"
                               Text="Нет сборок"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="Collapsed"/>
                </Grid>
                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="68"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="SkinButton" Content="Скин" Click="SkinButton_Click"/>
                    <TextBlock Grid.Column="1" Text="RAM" Margin="12,0,6,0"/>
                    <TextBox Grid.Column="2" x:Name="MemoryTextBox" TextAlignment="Center" FontSize="16"
                             PreviewTextInput="MemoryTextBox_PreviewTextInput"
                             TextChanged="MemoryTextBox_TextChanged"
                             DataObject.Pasting="MemoryTextBox_Pasting"
                             LostFocus="MemoryTextBox_LostFocus" KeyDown="MemoryTextBox_KeyDown"/>
                    <TextBlock Grid.Column="3" Text="GB" Margin="6,0,0,0"/>
                </Grid>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="IP" Margin="0,10,0,0"/>
                <Grid Grid.Row="1" Grid.Column="4" Margin="8,10,0,0">
                    <local:CenteredDropDown x:Name="NetworkAddressComboBox"
                                            ItemTemplate="{StaticResource NetworkAddressItemTemplate}"
                                            SelectionChanged="NetworkAddressComboBox_SelectionChanged"/>
                    <TextBlock x:Name="NetworkAddressPlaceholderText"
                               Text="Сетевой IP не найден"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="Collapsed"/>
                </Grid>
            </Grid>

            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,16,6"
                        VerticalAlignment="Top">
                <TextBlock Text="Передача мира" Style="{StaticResource SectionTitleStyle}"/>
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Мир"/>
                    <Grid Grid.Column="1">
                        <local:CenteredDropDown x:Name="WorldComboBox"
                                                ItemTemplate="{StaticResource WorldItemTemplate}"
                                                SelectionChanged="WorldComboBox_SelectionChanged"/>
                        <TextBlock x:Name="WorldPlaceholderText"
                                   Text="Нет миров для передачи"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                   HorizontalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Игрок"/>
                    <Grid Grid.Column="1">
                        <local:CenteredDropDown x:Name="OnlinePlayerComboBox"
                                                ItemTemplate="{StaticResource PeerItemTemplate}"
                                                SelectionChanged="TransferSelectionChanged"/>
                        <TextBlock x:Name="OnlinePlayerPlaceholderText"
                                   Text="Нет игроков в сети"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                   HorizontalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </StackPanel>

            <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,16,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" MinHeight="28">
                    <Border Style="{StaticResource ProgressFrameStyle}">
                        <ProgressBar x:Name="TransferProgressBar" Minimum="0" Maximum="100"
                                     Foreground="{StaticResource ProgressIdleBrush}"/>
                    </Border>
                    <TextBlock x:Name="TransferProgressText" Text="В ожидании мира"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Grid>
                <Button Grid.Column="1" x:Name="TransferButton" Content="Передать"
                        Click="TransferButton_Click" Margin="8,0,0,0" MinWidth="88"/>
            </Grid>

            <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,16,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" MinHeight="28">
                    <Border Style="{StaticResource ProgressFrameStyle}">
                        <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="100"
                                     Foreground="{StaticResource ProgressIdleBrush}"/>
                    </Border>
                    <TextBlock x:Name="UpdateProgressText" Text="Вы на последней версии"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Grid>
                <Button Grid.Column="1" x:Name="UpdateButton" Content="Обновить"
                        Click="UpdateButton_Click" Margin="8,0,0,0" MinWidth="88" IsEnabled="False"/>
            </Grid>

            <Grid Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,16,8">
                <Border Style="{StaticResource ProgressFrameStyle}">
                    <ProgressBar x:Name="RuntimeProgressBar" Minimum="0" Maximum="100"
                                 Foreground="{StaticResource ProgressIdleBrush}"/>
                </Border>
                <TextBlock x:Name="RuntimeProgressText" Text="В ожидании игры"
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </Grid>

            <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="7" Margin="10,0,0,0">
                <TextBlock Text="Steam" Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock x:Name="SteamStatusText" TextWrapping="Wrap" MinHeight="34"
                           Text="Подключение к Steam…"/>
                <Button x:Name="RetrySteamButton" Content="Повторить" Margin="0,4,0,12"
                        HorizontalAlignment="Left" Padding="10,2"
                        Click="RetrySteamButton_Click"/>
                <TextBlock Text="Диагностика" Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock Text="Передавать логи" Margin="0,0,0,4"/>
                <local:CenteredDropDown x:Name="DiagnosticLogTargetComboBox"
                                        ItemTemplate="{StaticResource DiagnosticTargetItemTemplate}"
                                        SelectionChanged="DiagnosticLogTargetComboBox_SelectionChanged"/>
                <TextBlock x:Name="DiagnosticLogStatusText"
                           TextWrapping="Wrap" Margin="0,8,0,0" MinHeight="34"
                           VerticalAlignment="Top"/>
                <Button x:Name="OpenSupportLogsButton"
                        Content="Открыть полученные логи"
                        Margin="0,4,0,0"
                        Click="OpenSupportLogsButton_Click"/>
            </StackPanel>

            <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="Лучше TLauncher" HorizontalAlignment="Left" FontSize="11"/>
            <TextBlock Grid.Row="7" Grid.Column="2" x:Name="VersionTextBlock"
                       HorizontalAlignment="Right" TextAlignment="Right" FontSize="11"/>

            <Grid Visibility="Collapsed">
                <TextBlock x:Name="PackHashText"/>
                <TextBlock x:Name="TransferStatusText"/>
                <TextBox x:Name="LogTextBox"/>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
