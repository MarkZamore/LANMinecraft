<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>LANMinecraft</AssemblyName>
    <RootNamespace>Minecraft</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ReleaseNumber Condition="'$(ReleaseNumber)' == ''">1</ReleaseNumber>
    <Version>1.0.$(ReleaseNumber)</Version>
    <FileVersion>1.0.$(ReleaseNumber).0</FileVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- The dependency audit is in Directory.Build.props, shared with the
         tests and the delta tool. -->
    <NoWarn>$(NoWarn);CA1822</NoWarn>
    <InformationalVersion Condition="'$(SourceRevisionId)' != ''">$(Version)+$(SourceRevisionId)</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>false</SelfContained>
    <!-- Only application files are embedded. The native host prepares the
         pinned external Desktop Runtime and resources before entering .NET. -->
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <!--
      Deliberately off. A single file that carries a compressed payload and
      unpacks it to run is, in shape, exactly a packer - and that is what a
      behavioural scanner reads it as. Microsoft says so themselves in the
      single-file documentation: compression raises the false-positive rate
      with antivirus software.

      It stopped being theoretical on 1 September 2026, when Defender took
      LANMinecraft.exe into quarantine as Behavior:Win32/GenCodeInjected.H on
      two machines at once and one player simply could not start the launcher.
      A launcher that needs an exclusion set up before it runs is a launcher
      that does not work, because the person who has to set it up is a friend
      who only wanted to play.

      The file gets bigger for it. That is the trade, and it is not close.
    -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishDir>..\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Match the reference application's early D3D dirty-region workaround.
         The CLR applies this before WPF initializes its rendering cache;
         single-file publishing embeds it without runtime file/registry writes. -->
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Media.MediaContext.DisableDirtyRectangles"
                                    Value="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- The version history the window shows; hand-written, one entry per
         commit, checked by the release workflow. See ChangelogService. -->
    <EmbeddedResource Include="Changelog.md"
                      LogicalName="Minecraft.Changelog.md" />
    <!-- The matching SDK 1.60 native is prepared by the bootstrap's pinned
         steam-native component; this package supplies the managed API only. -->
    <PackageReference Include="Steamworks.NET" Version="2024.8.0" />
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />
    <PackageReference Include="BsDiff" Version="1.1.0" />
  </ItemGroup>

  <Target Name="UseFinalWpfAssemblyForPublish"
          BeforeTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(PublishSingleFile)' == 'true'">
    <PropertyGroup>
      <_FinalWpfAssembly>$(IntermediateOutputPath)$(TargetFileName)</_FinalWpfAssembly>
    </PropertyGroup>
    <Error Condition="!Exists('$(_FinalWpfAssembly)')"
           Text="The final WPF assembly was not built: $(_FinalWpfAssembly)" />
    <ItemGroup>
      <IntermediateAssembly Remove="@(IntermediateAssembly)" />
      <IntermediateAssembly Include="$(_FinalWpfAssembly)" />
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(SourceRevisionId)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SourceRevisionId</_Parameter1>
      <_Parameter2>$(SourceRevisionId)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ReleaseNumber</_Parameter1>
      <_Parameter2>$(ReleaseNumber)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Offline fallback copied from the published GitHub pack-catalog index. -->
    <EmbeddedResource Include="LibrarySeed\catalog.json" LogicalName="Minecraft.Library.catalog.json" />
    <EmbeddedResource Include="Resources\pack-display-names.json" LogicalName="Minecraft.PackDisplayNames.json" />
    <EmbeddedResource Include="LibrarySeed\*.zip" LogicalName="Minecraft.Library.%(Filename)%(Extension)" />
    <Compile Remove="Build\**" />
    <Compile Remove="Patch\**" />
    <Compile Remove="publish\**" />
    <EmbeddedResource Remove="Build\**" />
    <EmbeddedResource Remove="Patch\**" />
    <EmbeddedResource Remove="publish\**" />
    <None Remove="Build\**" />
    <None Remove="Patch\**" />
    <None Remove="publish\**" />
    <Page Remove="Build\**" />
    <Page Remove="Patch\**" />
    <Page Remove="publish\**" />
  </ItemGroup>

</Project>
