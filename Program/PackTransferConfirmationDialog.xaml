<Window x:Class="Minecraft.PackTransferConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Приём сборки"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{DynamicResource WindowStyle}">
    <StackPanel x:Name="TransferPanel"
                Width="{StaticResource Size.DialogWidth}"
                Margin="{StaticResource Gap.Canvas}">
        <TextBlock Text="Принять сборку от друга?"
                   FontSize="{StaticResource Font.SizeHeading}"
                   Style="{StaticResource EmphasisTextStyle}"
                   TextWrapping="Wrap"/>
        <TextBlock x:Name="OfferText"
                   Margin="{StaticResource Gap.Above2}"
                   TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource Gap.Above4}">
            <Button Content="Принять" Padding="{StaticResource Pad.Wide}" Click="Accept_Click"/>
            <Button Content="Отказаться" IsCancel="True" IsDefault="True"
                    Margin="{StaticResource Gap.Left2}" Padding="{StaticResource Pad.Wide}"/>
        </StackPanel>
    </StackPanel>
</Window>
