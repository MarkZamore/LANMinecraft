<Window x:Class="Minecraft.BuildRemovalConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Удаление сборки"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{DynamicResource WindowStyle}">
    <Window.Resources>
        <DataTemplate x:Key="RemovalChoiceContentTemplate">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
        </DataTemplate>
    </Window.Resources>
    <StackPanel x:Name="RemovalPanel"
                Width="{StaticResource Size.DialogWidth}"
                Margin="{StaticResource Gap.Canvas}">
        <TextBlock x:Name="QuestionText"
                   FontSize="{StaticResource Font.SizeHeading}"
                   Style="{StaticResource EmphasisTextStyle}"
                   TextWrapping="Wrap"/>
        <!-- Enter, Escape and closing the window keep everything as it is. -->
        <Grid Margin="{StaticResource Gap.Above4}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{StaticResource Size.DialogActionGap}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource Size.DialogActionGap}"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Button x:Name="ListOnlyButton" Grid.Row="0" Grid.Column="0" Content="Убрать из списка"
                    ContentTemplate="{StaticResource RemovalChoiceContentTemplate}"
                    Padding="{StaticResource Pad.Wide}" Click="ListOnlyButton_Click"/>
            <Button x:Name="BuildOnlyButton" Grid.Row="0" Grid.Column="2" Content="Удалить сборку"
                    ContentTemplate="{StaticResource RemovalChoiceContentTemplate}"
                    Padding="{StaticResource Pad.Wide}" Click="BuildOnlyButton_Click"/>
            <Button x:Name="WithWorldsButton" Grid.Row="2" Grid.Column="0" Content="Удалить сборку с мирами"
                    ContentTemplate="{StaticResource RemovalChoiceContentTemplate}"
                    Padding="{StaticResource Pad.Wide}"
                    Click="WithWorldsButton_Click"/>
            <Button x:Name="KeepButton" Grid.Row="2" Grid.Column="2" Content="Не хочу" IsCancel="True" IsDefault="True"
                    ContentTemplate="{StaticResource RemovalChoiceContentTemplate}"
                    Padding="{StaticResource Pad.Wide}"
                    Click="KeepButton_Click"/>
        </Grid>
    </StackPanel>
</Window>
