<Window x:Class="Minecraft.BuildRemovalConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Удаление сборки"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{DynamicResource WindowStyle}">
    <StackPanel x:Name="RemovalPanel"
                Width="{StaticResource Size.DialogWidth}"
                Margin="{StaticResource Gap.Canvas}">
        <TextBlock x:Name="QuestionText"
                   FontSize="{StaticResource Font.SizeHeading}"
                   Style="{StaticResource EmphasisTextStyle}"
                   TextWrapping="Wrap"/>
        <TextBlock x:Name="ExplanationText" Margin="{StaticResource Gap.Above2}" TextWrapping="Wrap"/>
        <TextBlock x:Name="WorldsText"
                   Margin="{StaticResource Gap.Above2}"
                   Style="{StaticResource ParagraphTextStyle}"
                   TextWrapping="Wrap"/>
        <!-- Enter, Escape and closing the window keep everything as it is. -->
        <StackPanel Margin="{StaticResource Gap.Above4}">
            <Button x:Name="ListOnlyButton" Content="Убрать из списка"
                    Padding="{StaticResource Pad.Wide}" Click="ListOnlyButton_Click"/>
            <Button x:Name="BuildOnlyButton" Content="Удалить сборку"
                    Margin="{StaticResource Gap.Above2}"
                    Padding="{StaticResource Pad.Wide}" Click="BuildOnlyButton_Click"/>
            <Button x:Name="WithWorldsButton" Content="Удалить сборку с мирами"
                    Margin="{StaticResource Gap.Above2}" Padding="{StaticResource Pad.Wide}"
                    Click="WithWorldsButton_Click"/>
            <Button x:Name="KeepButton" Content="Не хочу" IsCancel="True" IsDefault="True"
                    Margin="{StaticResource Gap.Above2}" Padding="{StaticResource Pad.Wide}"
                    Click="KeepButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
