<Window x:Class="Minecraft.IdentityConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Привязка прогресса к Steam"
        SizeToContent="Height"
        Width="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="18">
        <TextBlock Text="Какой прогресс использовать для этого аккаунта Steam?"
                   FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="ExplanationText" Margin="0,10,0,0" TextWrapping="Wrap"/>
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="• Оставить старый профиль (рекомендуется) — квесты, команды FTB, дома и инвентарь из UUID.json останутся вашими."/>
        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="• Использовать профиль Steam — активным станет прогресс, уже найденный в мирах под этим аккаунтом."/>
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11"
                   Text="Ни один профиль не удаляется: UUID.json не изменяется, а выбор записывается в Minecraft\Personal\steam-identity.json и отменяется удалением этого файла."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="KeepLegacyButton" Content="Оставить старый профиль"
                    IsDefault="True" Padding="12,4" Click="KeepLegacyButton_Click"/>
            <Button x:Name="UseDerivedButton" Content="Использовать профиль Steam"
                    Margin="8,0,0,0" Padding="12,4" Click="UseDerivedButton_Click"/>
            <Button x:Name="CancelButton" Content="Отмена" IsCancel="True"
                    Margin="8,0,0,0" Padding="12,4" Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
