<Window x:Class="Minecraft.WorldTransferConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Приём мира"
        SizeToContent="Height"
        Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="18">
        <TextBlock Text="Принять мир от друга?"
                   FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="ExplanationText" Margin="0,10,0,0" TextWrapping="Wrap"/>
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11"
                   Text="Мир будет скопирован в Minecraft\Worlds. Ваши миры не изменятся. Если вы не ждёте передачу — откажитесь."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="AcceptButton" Content="Принять" IsDefault="True"
                    Padding="16,4" Click="AcceptButton_Click"/>
            <Button x:Name="DeclineButton" Content="Отказаться" IsCancel="True"
                    Margin="8,0,0,0" Padding="16,4" Click="DeclineButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
