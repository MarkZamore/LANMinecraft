<Window x:Class="Minecraft.WorldTransferConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Приём мира"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{DynamicResource WindowStyle}">
    <StackPanel x:Name="TransferPanel"
                Width="{StaticResource Size.DialogWidth}"
                Margin="{StaticResource Gap.Canvas}">
        <TextBlock Text="Принять мир от друга?"
                   FontSize="{StaticResource Font.SizeHeading}"
                   Style="{StaticResource EmphasisTextStyle}"
                   TextWrapping="Wrap"/>
        <TextBlock x:Name="ExplanationText" Margin="{StaticResource Gap.Above2}" TextWrapping="Wrap"/>
        <TextBlock Margin="{StaticResource Gap.Above2}"
                   Style="{StaticResource ParagraphTextStyle}"
                   Text="Мир будет скопирован в Minecraft\Worlds. Ваши миры не изменятся. Если вы не ждёте передачу — откажитесь."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource Gap.Above4}">
            <Button x:Name="AcceptButton" Content="Принять" IsDefault="True"
                    Padding="{StaticResource Pad.Wide}" Click="AcceptButton_Click"/>
            <Button x:Name="DeclineButton" Content="Отказаться" IsCancel="True"
                    Margin="{StaticResource Gap.Left2}" Padding="{StaticResource Pad.Wide}" Click="DeclineButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
