<UserControl x:Class="Minecraft.PackLibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Minecraft"
    Foreground="{DynamicResource Brush.Text}"
    FontFamily="{DynamicResource Font.Family}" FontSize="{DynamicResource Font.SizeBody}"
    Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="LibraryModLinkStyle" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/><Setter Property="TextDecorations" Value="Underline"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="TextDecorations" Value="Underline"/></Trigger>
                <DataTrigger Binding="{Binding WebsiteUri}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/><Setter Property="Cursor" Value="Arrow"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/><Setter Property="TextDecorations" Value="{x:Null}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LibraryCardStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource Border.Control}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <local:RoundedClipBorder x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius.Panel}">
                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </local:RoundedClipBorder>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/><Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.SurfacePressed}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="LibrarySectionStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource Border.Control}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Panel}"/>
            <Setter Property="Padding" Value="{DynamicResource Pad.Panel}"/>
            <Setter Property="Margin" Value="{DynamicResource Gap.Below4}"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="LibraryTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="local:LibraryTreeMotion.IsEnabled" Value="True"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="{DynamicResource Size.LibraryTreeIndent}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border x:Name="TreeLine" Grid.Row="1" Width="{DynamicResource Size.BorderWidth}" Background="{DynamicResource Brush.BorderStrong}" HorizontalAlignment="Center"/>
                    <ToggleButton x:Name="Expander" Grid.Row="0" MinHeight="{DynamicResource Font.LineHeightBody}"
                        Padding="{DynamicResource Pad.None}" BorderThickness="{DynamicResource Border.None}" Background="Transparent"
                        Foreground="{DynamicResource Brush.TextMuted}" Focusable="False"
                        IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid Background="Transparent"><Path x:Name="Chevron" Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}" Stretch="Uniform" Data="M 0,0 L 5,5 L 10,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="{DynamicResource Size.GlyphStroke}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform/></Path.RenderTransform></Path></Grid></ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <Border x:Name="HeaderSurface" Grid.Column="1" Padding="{DynamicResource Pad.Small}" MinHeight="{DynamicResource Font.LineHeightBody}" CornerRadius="{DynamicResource Radius.Control}">
                        <ContentPresenter x:Name="PART_Header" ContentSource="Header" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="ChildrenReveal" Grid.Row="1" Grid.Column="1" Visibility="Collapsed" ClipToBounds="True"><ItemsPresenter x:Name="Children"/></Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/><Setter TargetName="TreeLine" Property="Visibility" Value="Collapsed"/></Trigger>
                    <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ChildrenReveal" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsExpanded" Value="False"><Setter TargetName="TreeLine" Property="Visibility" Value="Collapsed"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type local:CatalogModNode}" ItemsSource="{Binding Children}">
            <TextBlock TextWrapping="Wrap" ToolTip="{Binding Version}"><Hyperlink Style="{StaticResource LibraryModLinkStyle}" NavigateUri="{Binding WebsiteUri}" ToolTip="{Binding WebsiteUri}" Click="ModLink_Click"><Run Text="{Binding Name, Mode=OneWay}"/></Hyperlink></TextBlock>
        </HierarchicalDataTemplate>
        <DataTemplate x:Key="LibraryModGroupTemplate">
            <TreeView Background="Transparent" BorderThickness="{DynamicResource Border.None}" Padding="{DynamicResource Pad.None}"
                Foreground="{DynamicResource Brush.Text}" ItemContainerStyle="{StaticResource LibraryTreeItemStyle}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <TreeViewItem Header="{Binding}" ItemsSource="{Binding Children}" ItemContainerStyle="{StaticResource LibraryTreeItemStyle}"
                    Style="{StaticResource LibraryTreeItemStyle}"/>
            </TreeView>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="LibraryTopBar" Margin="{DynamicResource Gap.Below4}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="{DynamicResource Size.ColumnGap}"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="{DynamicResource Size.LibraryActionGap}"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <Button x:Name="ReturnLauncherButton" Content="Вернуться в лаунчер" Click="ReturnLauncher_Click" HorizontalAlignment="Stretch" MinHeight="{DynamicResource Size.Primary}"/>
            </Grid>
        </Grid>
        <ScrollViewer x:Name="CatalogScroll" Grid.Row="1" Margin="{DynamicResource Gap.None}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Добавь сборку" FontSize="{DynamicResource Font.SizeHeading}" FontWeight="{DynamicResource Font.WeightEmphasis}" Margin="{DynamicResource Gap.Below4}"/>
                <ItemsControl x:Name="CatalogCards">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:LibraryColumnsPanel MinimumColumnWidth="{DynamicResource Size.LibraryCardWidth}" FixedColumnWidth="{DynamicResource Size.LibraryCardWidth}" UniformItemHeight="True" Gap="{DynamicResource Space.4}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Button Style="{StaticResource LibraryCardStyle}" Click="PackCard_Click" AutomationProperties.Name="{Binding Name}">
                            <StackPanel>
                                <local:LibraryPreviewImage Source="{Binding Preview}" Stretch="UniformToFill"/>
                                <StackPanel Margin="{DynamicResource Pad.LibraryCard}">
                                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Font.SizeHeading}" FontWeight="{DynamicResource Font.WeightEmphasis}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding VersionLabel}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="{DynamicResource Font.SizeCaption}" Margin="{DynamicResource Gap.Above1}"/>
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                                        LineHeight="{DynamicResource Font.LineHeightBody}" Foreground="{DynamicResource Brush.TextMuted}" Margin="{DynamicResource Gap.Above1}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="DetailScroll" Grid.RowSpan="2" Margin="{DynamicResource Gap.None}" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="DetailContent">
                <local:RoundedClipBorder Style="{StaticResource LibrarySectionStyle}" Padding="{DynamicResource Pad.None}" Height="{DynamicResource Size.LibraryHero}">
                    <Grid>
                        <Image Source="{Binding Preview}" Stretch="UniformToFill"/>
                        <Border Background="{DynamicResource Brush.LibraryHeroOverlay}"/>
                        <Grid Margin="{DynamicResource Pad.Panel}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Button Content="← Назад" Click="ReturnCatalog_Click" HorizontalAlignment="Left"/>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Bottom" Margin="{DynamicResource Gap.Right3}">
                                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Font.SizeHeading}" FontWeight="{DynamicResource Font.WeightEmphasis}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding VersionLabel}" Margin="{DynamicResource Gap.Above2}" Foreground="{DynamicResource Brush.TextMuted}"/>
                                </StackPanel>
                                <Button x:Name="MembershipButton" Grid.Column="1" Click="Membership_Click" Content="Добавить" MinHeight="{DynamicResource Size.Primary}" Padding="{DynamicResource Pad.Wide}" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </local:RoundedClipBorder>
                <Border Style="{StaticResource LibrarySectionStyle}">
                    <StackPanel><TextBlock Text="О сборке" FontSize="{DynamicResource Font.SizeHeading}" FontWeight="{DynamicResource Font.WeightEmphasis}" Margin="{DynamicResource Gap.Below3}"/>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" LineHeight="{DynamicResource Font.LineHeightBody}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource LibrarySectionStyle}">
                    <StackPanel>
                        <TextBlock Text="Моды" FontSize="{DynamicResource Font.SizeHeading}" FontWeight="{DynamicResource Font.WeightEmphasis}" Margin="{DynamicResource Gap.Below3}"/>
                        <ItemsControl ItemsSource="{Binding Mods}" ItemTemplate="{StaticResource LibraryModGroupTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:LibraryColumnsPanel MinimumColumnWidth="{DynamicResource Size.LibraryCardMin}" Gap="{DynamicResource Space.4}" RowGap="{DynamicResource Space.1}" BalanceHeight="True"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Text="Вспомогательные библиотеки" FontWeight="{DynamicResource Font.WeightEmphasis}" Margin="{DynamicResource Gap.Above4}"/>
                        <ItemsControl ItemsSource="{Binding Libraries}" Margin="{DynamicResource Gap.Above2}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:LibraryColumnsPanel MinimumColumnWidth="{DynamicResource Size.LibraryCardMin}" Gap="{DynamicResource Space.4}" RowGap="{DynamicResource Space.1}" BalanceHeight="True"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap" ToolTip="{Binding Version}"><Hyperlink Style="{StaticResource LibraryModLinkStyle}" Foreground="{DynamicResource Brush.TextMuted}" NavigateUri="{Binding WebsiteUri}" ToolTip="{Binding WebsiteUri}" Click="ModLink_Click"><Run Text="{Binding Name, Mode=OneWay}"/></Hyperlink></TextBlock></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
