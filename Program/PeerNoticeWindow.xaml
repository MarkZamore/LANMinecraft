<Window x:Class="Minecraft.PeerNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LANMinecraft"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Opacity="0"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Style="{DynamicResource WindowStyle}">
    <!-- Transparent so the rounded corner is the panel's and not a square of
         canvas behind it, and so the whole notice can be faded in and out. -->
    <Border x:Name="NoticeSurface"
            Width="{StaticResource Size.NoticeWidth}"
            Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.BorderStrong}"
            BorderThickness="{StaticResource Border.Control}"
            CornerRadius="{StaticResource Radius.Primary}"
            Padding="{StaticResource Gap.Canvas}">
        <StackPanel>
            <!-- Who, then what: the name carries the weight because it is the
                 word a player is looking for. -->
            <TextBlock x:Name="TitleText"
                       Style="{StaticResource EmphasisTextStyle}"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="BodyText"
                       Margin="{StaticResource Gap.Above1}"
                       Style="{StaticResource ParagraphTextStyle}"/>
        </StackPanel>
    </Border>
</Window>
