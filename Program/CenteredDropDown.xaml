<UserControl x:Class="Minecraft.CenteredDropDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="ControlRoot"
             MinHeight="{DynamicResource Size.Control}"
             Focusable="False"
             PreviewKeyDown="ControlRoot_PreviewKeyDown">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Family}"/>
            <Setter Property="FontSize" Value="{DynamicResource Font.SizeBody}"/>
            <Setter Property="FontWeight" Value="{DynamicResource Font.WeightBody}"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <!-- The launcher's drop-down: a surface like every other control, the
         chosen value reading left like every other value, and a list below on
         the same surface. Colours and sizes are the tokens in App.xaml, named
         dynamically: this control is compiled and built inside other markup,
         and a static lookup would run before the tokens are in reach. -->
    <UserControl.Resources>
        <Style x:Key="DropDownToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource Border.Control}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Control}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>

                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.SurfacePressed}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                                <!-- Let the popup's outside-click capture close the list.
                                     Otherwise this click toggles the button back on after Closed. -->
                                <Setter Property="IsHitTestVisible" Value="False"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.SurfaceDisabled}"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Brush.BorderDisabled}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <ToggleButton x:Name="DropDownButton"
                      MinHeight="{DynamicResource Size.Control}"
                      Padding="{DynamicResource Pad.None}"
                      Style="{DynamicResource DropDownToggleStyle}"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch"
                      Checked="DropDownButton_Checked"
                      Unchecked="DropDownButton_Unchecked">
            <Grid>
                <ContentPresenter Content="{Binding SelectedItem, ElementName=ControlRoot}"
                                  ContentTemplate="{Binding ItemTemplate, ElementName=ControlRoot}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Margin="{DynamicResource Pad.DropDownText}"/>
                <Path x:Name="DropDownChevron"
                      Width="{DynamicResource Size.ChevronWidth}"
                      Height="{DynamicResource Size.ChevronHeight}"
                      Data="M 0,0 L 5,5 L 10,0"
                      Stroke="{DynamicResource Brush.Text}"
                      StrokeThickness="{DynamicResource Size.GlyphStroke}"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Margin="{DynamicResource Gap.Right3}"
                      RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                    <Path.RenderTransform><RotateTransform Angle="-90"/></Path.RenderTransform>
                </Path>
            </Grid>
        </ToggleButton>

        <Popup x:Name="DropDownPopup"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=DropDownButton}"
               StaysOpen="False"
               AllowsTransparency="True"
               Opened="DropDownPopup_Opened"
               Closed="DropDownPopup_Closed">
            <Border Width="{Binding ActualWidth, ElementName=ControlRoot}"
                    MaxHeight="{DynamicResource Size.PopupMax}"
                    Margin="{DynamicResource Gap.Above1}"
                    Background="{DynamicResource Brush.ListPopup}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="{DynamicResource Border.Control}"
                    CornerRadius="{DynamicResource Radius.Panel}"
                    Padding="{DynamicResource Pad.Popup}"
                    SnapsToDevicePixels="True">
                <ListBox x:Name="ItemsList"
                         ItemsSource="{Binding ItemsSource, ElementName=ControlRoot}"
                         ItemTemplate="{Binding ItemTemplate, ElementName=ControlRoot}"
                         Background="Transparent"
                         BorderThickness="{DynamicResource Border.None}"
                         Padding="{DynamicResource Pad.None}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="ControlRoot_PreviewKeyDown"
                         PreviewMouseLeftButtonUp="ItemsList_PreviewMouseLeftButtonUp"
                         SelectionChanged="ItemsList_SelectionChanged"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>
