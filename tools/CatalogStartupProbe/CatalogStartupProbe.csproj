<Project>
  <PropertyGroup>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\CatalogStartupProbe\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\CatalogStartupProbe\obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SelfContained>false</SelfContained>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <AssemblySearchPaths>{HintPathFromItem};$(AssemblySearchPaths)</AssemblySearchPaths>
  </PropertyGroup>
  <ItemGroup Condition="'$(LauncherAssemblyPath)' == ''">
    <ProjectReference Include="../../Program/Minecraft.csproj" AdditionalProperties="SkipPortableIdentityAdapter=true" />
  </ItemGroup>
  <ItemGroup Condition="'$(LauncherAssemblyPath)' != ''">
    <Reference Include="LANMinecraft"><HintPath>$(LauncherAssemblyPath)</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <Target Name="ValidateExplicitLauncherAssembly" BeforeTargets="ResolveAssemblyReferences" Condition="'$(LauncherAssemblyPath)' != ''">
    <Error Condition="!Exists('$(LauncherAssemblyPath)')" Text="LauncherAssemblyPath must name an existing managed LANMinecraft.dll." />
  </Target>
  <Target Name="CopyExplicitLauncherDependencies" AfterTargets="Build" Condition="'$(LauncherAssemblyPath)' != ''">
    <ItemGroup>
      <LauncherDependency Include="$([System.IO.Path]::GetDirectoryName('$(LauncherAssemblyPath)'))\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(LauncherDependency)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
