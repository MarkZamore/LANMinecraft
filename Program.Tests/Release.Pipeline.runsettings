<?xml version="1.0" encoding="utf-8"?>
<!-- Addressed profile for the CI-only rollout. The standard Release profile
     remains the default. Run through Test-Launcher.ps1 to validate the TRX. -->
<RunSettings>
  <RunConfiguration>
    <TestCaseFilter>FullyQualifiedName=Minecraft.Tests.ChangelogTests.TheNewestVersion_IsTheCommitItIsWrittenFor|
      FullyQualifiedName=Minecraft.Tests.ChangelogTests.EveryVersion_IsTwoShortSentences|
      FullyQualifiedName=Minecraft.Tests.ReleaseWorkflowTests.BuildAndVerificationRunIndependently_AndBothGatePublication|
      FullyQualifiedName=Minecraft.Tests.ReleaseWorkflowTests.BuildCreatesDeltasBeforeStaging_AndPublishUsesThatArtifact|
      FullyQualifiedName=Minecraft.Tests.ReleaseWorkflowTests.PublicationRequiresScanEvidenceForTheStagedExecutable|
      FullyQualifiedName=Minecraft.Tests.ReleaseWorkflowTests.TheDependencyAudit_IsPartOfEveryRestore|
      FullyQualifiedName=Minecraft.Tests.FunctionalAuditTests.Updater_FullDeltaFallbackCancellationInstallRestartAndRollback|
      FullyQualifiedName=Minecraft.Tests.NativePortableHostTests.OuterResourcesAndPacketKeepTheProductIdentityWithoutTheUnusedSdkApphost|
      FullyQualifiedName=Minecraft.Tests.NativePortableHostTests.ColdAndWarmStartsUseThePrivateRuntimePortableTempAndTheOuterStaProcess|
      FullyQualifiedName=Minecraft.Tests.NativePortableHostTests.NativeUpdaterWaitsForTheOuterProcessAndRestartsTheVerifiedReplacementAtItsPortableRoot</TestCaseFilter>
  </RunConfiguration>
</RunSettings>
