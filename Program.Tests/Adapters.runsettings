<?xml version="1.0" encoding="utf-8"?>
<!-- Compact universal adapter contracts: shared integrity/identity; mapped Forge/NeoForge;
     named modern runtime; Fabric/intermediary; native LAN/discovery/chunks; Java.
     Exact selectors avoid class-wide expansion; theory row counts remain reviewed.
     Historical compatibility matrix remains unchanged in AdaptersFull.runsettings.
     Pending Legacy Fabric tests are added only when their universal source is merged. -->
